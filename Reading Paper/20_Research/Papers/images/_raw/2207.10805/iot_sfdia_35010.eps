%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 1440 2560
%%LanguageLevel: 3
{
gsave
1440 2560 scale
13 dict begin
/DeviceRGB setcolorspace
/fa currentfile /ASCII85Decode filter def
/fb fa /FlateDecode filter def
<<
/ImageType 1
/Width 1440
/Height 2560
/ImageMatrix [1440 0 0 -2560 0 2560]
/BitsPerComponent 8
/MultipleDataSources false
/DataSource fb
/Decode [0 1 0 1 0 1]
/Interpolate true
>>
image
fb closefile
fa flushfile fa closefile
end
grestore
} exec
